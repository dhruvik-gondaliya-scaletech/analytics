NODE_ENV=development
PORT=3000

POSTGRES_URL=postgres://postgres:postgres@localhost:5432/analytics
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123

DASHBOARD_SESSION_SECRET=analytics-dev-secret-change-in-production
INGESTION_WRITE_TOKEN=default-write-token
CORS_ORIGINS=http://localhost:5173

INGESTION_MAX_PAYLOAD_BYTES=262144
INGESTION_BATCH_SIZE=500
INGESTION_BATCH_FLUSH_MS=1000
INGESTION_WORKER_CONCURRENCY=10
INGESTION_MAX_RETRIES=5

EVENT_RETENTION_DAYS=365